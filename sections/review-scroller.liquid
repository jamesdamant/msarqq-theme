{% comment %}
  Section contract.
  Continuously scrolling strip of short customer reviews: three cards per view on wide screens,
  two on tablets and about one on phones. The strip pauses on hover or with its pause control,
  and becomes a manual swipe row when reduced motion is preferred.
  Trust rules: the section renders nothing on the storefront until it has at least one Review
  block, and the rating summary is read from the product's reviews.rating / reviews.rating_count
  metafields (written by a reviews app), never typed in.
  @example
  <!-- Product page: add "Review scroller" and one Review block per real customer review -->
{% endcomment %}

{% liquid
  assign review_count = section.blocks.size
  assign show_section = false
  if review_count > 0 or request.design_mode
    assign show_section = true
  endif
%}

{% # Hidden on the storefront until it holds at least one real review %}
{% if show_section %}
{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign loop_duration = review_count | times: section.settings.seconds_per_review
  assign pause_id = 'ReviewScrollerPause-' | append: section.id

  assign summary_rating = blank
  if section.settings.show_rating_summary and product != blank
    assign summary_rating = product.metafields.reviews.rating.value.rating | round: 1
    assign summary_scale = product.metafields.reviews.rating.value.scale_max | default: 5 | round
    assign summary_count = product.metafields.reviews.rating_count.value | default: 0
    assign summary_filled = summary_rating | round
    if product.metafields.reviews.rating.value == blank
      assign summary_rating = blank
    endif
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  {% if section.settings.anchor_id != blank %}
    id="{{ section.settings.anchor_id | handle }}"
  {% endif %}
  class="section section--page-width spacing-style review-scroller{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section.settings -%}
    --review-scroller-duration: {{ loop_duration }}s;
    --review-scroller-card-background: {{ section.settings.card_background }};
    --review-scroller-card-border: {{ section.settings.card_border_color }};
    --review-scroller-star-color: {{ section.settings.star_color }};
    --review-scroller-radius: {{ section.settings.corner_radius }}px;
  "
>
  <div class="review-scroller__inner">
    <div class="review-scroller__header">
      <div class="review-scroller__intro">
        {% if section.settings.heading != blank %}
          <h2 class="h3 review-scroller__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if summary_rating != blank and summary_count > 0 %}
          <p class="review-scroller__summary">
            <span class="review-scroller__stars" aria-hidden="true">
              {%- for i in (1..summary_scale) -%}
                <svg
                  viewBox="0 0 24 24"
                  class="review-scroller__star{% if i > summary_filled %} review-scroller__star--empty{% endif %}"
                  focusable="false"
                >
                  <path d="m12 2.5 2.94 6.08 6.56.84-4.81 4.6 1.2 6.58L12 17.4l-5.89 3.2 1.2-6.58-4.81-4.6 6.56-.84z"/>
                </svg>
              {%- endfor -%}
            </span>
            {{
              'content.review_scroller_summary'
              | t: rating: summary_rating, scale_max: summary_scale, count: summary_count
            }}
          </p>
        {% endif %}
        {% if review_count == 0 %}
          <p class="review-scroller__empty">{{ 'content.review_scroller_empty' | t }}</p>
        {% endif %}
      </div>

      {% if review_count > 1 %}
        <div class="review-scroller__pause">
          <input
            id="{{ pause_id }}"
            type="checkbox"
            class="review-scroller__pause-input"
          >
          <label
            for="{{ pause_id }}"
            class="review-scroller__pause-label"
          >
            <span class="visually-hidden">{{ 'accessibility.pause_reviews' | t }}</span>
            <svg
              viewBox="0 0 24 24"
              class="review-scroller__pause-icon review-scroller__pause-icon--pause"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 5h3v14H8zM13 5h3v14h-3z"/>
            </svg>
            <svg
              viewBox="0 0 24 24"
              class="review-scroller__pause-icon review-scroller__pause-icon--play"
              aria-hidden="true"
              focusable="false"
            >
              <path d="M8 5.5v13l10.5-6.5z"/>
            </svg>
          </label>
        </div>
      {% endif %}
    </div>

    {% if review_count > 0 %}
      <div class="review-scroller__viewport">
        <div class="review-scroller__track">
          {% comment %} The second copy only exists to make the loop seamless, so it is hidden from assistive tech. {% endcomment %}
          {% for copy in (1..2) %}
            <ul
              class="review-scroller__list{% if copy == 2 %} review-scroller__list--clone{% endif %}"
              role="list"
              {% if copy == 1 %}
                aria-label="{{ 'accessibility.customer_reviews' | t }}"
              {% else %}
                aria-hidden="true"
                inert
              {% endif %}
            >
              {% for block in section.blocks %}
                {% liquid
                  assign rating = block.settings.rating
                  assign author = block.settings.author | escape
                %}
                <li
                  class="review-scroller__item"
                  {% if copy == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  <article class="review-card">
                    <p class="review-card__stars">
                      <span class="visually-hidden">{{ 'accessibility.review_rating' | t: rating: rating }}</span>
                      {%- for i in (1..5) -%}
                        <svg
                          viewBox="0 0 24 24"
                          class="review-card__star{% if i > rating %} review-card__star--empty{% endif %}"
                          aria-hidden="true"
                          focusable="false"
                        >
                          <path d="m12 2.5 2.94 6.08 6.56.84-4.81 4.6 1.2 6.58L12 17.4l-5.89 3.2 1.2-6.58-4.81-4.6 6.56-.84z"/>
                        </svg>
                      {%- endfor -%}
                    </p>

                    {% if block.settings.text != blank %}
                      <p class="review-card__text">{{ block.settings.text | escape | newline_to_br }}</p>
                    {% endif %}

                    <div class="review-card__footer">
                      {% if block.settings.image != blank %}
                        {% liquid
                          if copy == 1
                            assign photo_alt = 'accessibility.review_photo' | t: author: author
                          else
                            assign photo_alt = ''
                          endif
                        %}
                        {{
                          block.settings.image
                          | image_url: width: 160, height: 160, crop: 'center'
                          | image_tag:
                            width: 56,
                            height: 56,
                            widths: '56, 112, 160',
                            sizes: '56px',
                            loading: 'lazy',
                            alt: photo_alt,
                            class: 'review-card__photo'
                        }}
                      {% endif %}
                      <div class="review-card__meta">
                        {% if author != blank %}
                          <span class="review-card__author">{{ author }}</span>
                        {% endif %}
                        {% if block.settings.verified %}
                          <span class="review-card__verified">
                            <svg
                              viewBox="0 0 24 24"
                              aria-hidden="true"
                              focusable="false"
                            >
                              <path d="M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6 11-11-1.4-1.4z"/>
                            </svg>
                            {{ 'content.verified_buyer' | t }}
                          </span>
                        {% endif %}
                      </div>
                    </div>
                  </article>
                </li>
              {% endfor %}
            </ul>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </div>
</div>
{% endif %}

{% stylesheet %}
  .review-scroller {
    --review-scroller-gap: var(--gap-lg);
    --review-scroller-shift: -50%;

    /* Keeps the heading clear of the sticky header when reached through the anchor link */
    scroll-margin-top: calc(var(--header-height, 0px) + var(--margin-2xl));
  }

  .review-scroller:dir(rtl) {
    --review-scroller-shift: 50%;
  }

  .review-scroller__inner {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xl);
    min-width: 0;
  }

  .review-scroller__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gap-lg);
  }

  .review-scroller__intro {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs);
    min-width: 0;
  }

  .review-scroller__heading {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .review-scroller__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-xs);
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: var(--font-size--xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .review-scroller__stars,
  .review-card__stars {
    display: inline-flex;
    gap: 2px;
    color: var(--review-scroller-star-color);
  }

  .review-scroller__star {
    width: 1.125rem;
    height: 1.125rem;
    fill: currentcolor;
  }

  .review-scroller__star--empty {
    opacity: 0.25;
  }

  .review-scroller__empty {
    margin: 0;
    color: var(--color-foreground-muted);
  }

  /* Pause control: a native checkbox styled as a round button */
  .review-scroller__pause {
    position: relative;
    flex-shrink: 0;
  }

  .review-scroller__pause-input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .review-scroller__pause-label {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--style-border-radius-50);
    border: var(--style-border-width) solid var(--review-scroller-card-border);
    background-color: var(--review-scroller-card-background);
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color var(--animation-speed) var(--animation-easing);
  }

  .review-scroller__pause-input:focus-visible + .review-scroller__pause-label {
    outline: var(--focus-outline-width) solid currentcolor;
    outline-offset: var(--focus-outline-offset);
  }

  .review-scroller__pause-icon {
    grid-area: 1 / 1;
    width: 1.25rem;
    height: 1.25rem;
    fill: currentcolor;
  }

  .review-scroller__pause-icon--play,
  .review-scroller__pause-input:checked + .review-scroller__pause-label .review-scroller__pause-icon--pause {
    display: none;
  }

  .review-scroller__pause-input:checked + .review-scroller__pause-label .review-scroller__pause-icon--play {
    display: block;
  }

  /* Viewport sizes cards from its own width so the layout follows the column it is placed in */
  .review-scroller__viewport {
    --review-scroller-per-view: 1.15;

    container-type: inline-size;
    overflow: hidden;
    min-width: 0;
    mask-image: linear-gradient(
      to right,
      transparent,
      #000 var(--gap-lg),
      #000 calc(100% - var(--gap-lg)),
      transparent
    );
  }

  .review-scroller__track {
    display: flex;
    width: max-content;
  }

  .review-scroller__list {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each item carries its own trailing gap so both copies are exactly equal and the loop is seamless */
  .review-scroller__item {
    display: flex;
    flex-shrink: 0;
    width: calc((100cqi + var(--review-scroller-gap)) / var(--review-scroller-per-view) - var(--review-scroller-gap));
    margin-inline-end: var(--review-scroller-gap);
  }

  @container (min-width: 37.5rem) {
    .review-scroller__item {
      --review-scroller-per-view: 2;
    }
  }

  @container (min-width: 56rem) {
    .review-scroller__item {
      --review-scroller-per-view: 3;
    }
  }

  .review-card {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    width: 100%;
    min-width: 0;
    padding: var(--padding-2xl);
    border: var(--style-border-width) solid var(--review-scroller-card-border);
    border-radius: var(--review-scroller-radius);
    background-color: var(--review-scroller-card-background);
  }

  .review-card__stars {
    margin: 0;
  }

  .review-card__star {
    width: 1rem;
    height: 1rem;
    fill: currentcolor;
  }

  .review-card__star--empty {
    opacity: 0.25;
  }

  .review-card__text {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    line-clamp: 5;
  }

  .review-card__footer {
    display: flex;
    align-items: center;
    gap: var(--gap-sm);
    margin-block-start: auto;
    min-width: 0;
  }

  .review-card__photo {
    flex-shrink: 0;
    width: 3.5rem;
    height: 3.5rem;
    object-fit: cover;
    border-radius: var(--style-border-radius-md);
  }

  .review-card__meta {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs);
    min-width: 0;
  }

  .review-card__author {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    overflow-wrap: anywhere;
  }

  .review-card__verified {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-3xs);
    font-family: var(--font-accent--family);
    font-size: var(--font-size--xs);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-foreground-muted);
  }

  .review-card__verified svg {
    width: 0.875rem;
    height: 0.875rem;
    fill: currentcolor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .review-scroller__track {
      animation: review-scroller-loop var(--review-scroller-duration) linear infinite;
    }

    .review-scroller__viewport:hover .review-scroller__track,
    .review-scroller:has(.review-scroller__pause-input:checked) .review-scroller__track {
      animation-play-state: paused;
    }
  }

  /* Without motion the strip becomes a swipeable row and the loop copy and pause control are not needed */
  @media (prefers-reduced-motion: reduce) {
    .review-scroller__viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      mask-image: none;
    }

    .review-scroller__item {
      scroll-snap-align: start;
    }

    .review-scroller__list--clone,
    .review-scroller__pause {
      display: none;
    }
  }

  @keyframes review-scroller-loop {
    to {
      transform: translateX(var(--review-scroller-shift));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.review_scroller",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "customer_review",
      "name": "t:names.review",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:settings.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "t:settings.text"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:settings.author"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "t:settings.verified_buyer",
          "info": "t:info.review_verified_buyer",
          "default": false
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "checkbox",
      "id": "show_rating_summary",
      "label": "t:settings.show_rating_summary",
      "info": "t:info.show_rating_summary",
      "default": true
    },
    {
      "type": "range",
      "id": "seconds_per_review",
      "label": "t:settings.seconds_per_review",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "t:settings.anchor_id",
      "info": "t:info.anchor_id"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "t:settings.card_background",
      "default": "{{ settings.color_palette.background }}"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "t:settings.border_color",
      "default": "{{ settings.color_palette.color2 }}"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "t:settings.star_color",
      "default": "{{ settings.color_palette.foreground }}"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "t:settings.corner_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "t:names.review_scroller",
      "category": "t:categories.storytelling",
      "settings": {
        "heading": "t:text_defaults.review_scroller_heading"
      }
    }
  ]
}
{% endschema %}
